# Settings for the pre-release gate - copy to .env and fill in.
#
#   cp .env.example .env
#
# .env is gitignored, and holds an AWX token and a vCenter password, so
# keep it to yourself: `chmod 600 .env`. It is sourced as bash by the
# harness scripts, so quote anything with spaces. Anything already
# exported in your shell wins over what is set here, so a one-off run
# can override a value without editing this file:
#
#   AWX_TEMPLATE="Some Other Template" make verify-supervisor
#
# The whole loop, once this is filled in:
#
#   make dev-release
#   make install-supervisor-service
#   make verify-supervisor
#
# See CONTRIBUTING.md § Pre-release validation for what each step does.

# --- what is being released -------------------------------------------
# The pre-release version to build, push and install. Also settable on
# the command line: `make dev-release DEV_VERSION=1.0.1-rc2`.
DEV_VERSION=1.0.1-rc1

# --- the Supervisor ----------------------------------------------------
# Kubeconfig for the Supervisor. Needed by verify-supervisor, and it lets
# install-supervisor-service wait for the Deployment to actually roll.
KUBECONFIG="$HOME/.kube/config"

# The tenant namespace to run the binding in. A real one - the harness
# creates and removes its own resources inside it.
SUPERVISOR_NS=my-namespace

# --- vCenter, for the install step -------------------------------------
# The Supervisor's RBAC refuses even a vSphere administrator the right to
# create CRDs and ClusterRoles, so the service can only land through
# vCenter's service-install API.
VC_HOST=vc01.example.lab
VC_USER=administrator@vsphere.local

# The password. It is written to a 0600 temp file for the length of the
# run and handed to curl as a config file, so it never reaches the
# process list - same handling either way.
VC_PASSWORD=

# Or keep it out of this file entirely, in one only you can read:
#
#   read -rs "P?vCenter password: " && printf '%s' "$P" > ~/.vc_pw && unset P
#
#VC_PASSWORD_FILE="$HOME/.vc_pw"

# Cluster id (e.g. domain-c9). Auto-discovered if the vCenter has one.
#VC_CLUSTER=

# --- AWX ---------------------------------------------------------------
AWX_URL=https://awx.example.com
AWX_TOKEN=

# Must have Prompt on Launch enabled for Limit (and for Variables), and
# must have an inventory. Checked in a preflight pass before anything is
# created.
AWX_TEMPLATE="Configure Webserver"

# Set to WorkflowTemplate to gate a workflow instead of a job template.
#TEMPLATE_TYPE=JobTemplate

# --- the VM to run against ---------------------------------------------
# Left unset, the harness creates its own fixture VM and destroys it
# afterwards, discovering image, class and storage class from the
# namespace. That needs a public key whose private half AWX already holds
# in the Machine credential on the template.
SSH_PUBLIC_KEY_FILE="$HOME/.ssh/awx_ansible.pub"

# Or point at a VM you manage yourself, and fixtures are left alone.
#VM_LABEL=app=webserver

# DESTRUCTIVE, and only for an AWX you own: generate a fresh keypair per
# run and overwrite the private key on the AWX Machine credential. The
# old key cannot be read back first, so anything else authenticating with
# that credential breaks.
#MANAGE_AWX_CREDENTIAL=1
#AWX_CREDENTIAL_ID=

# An IP is not a running sshd - vm-operator reports the address while
# cloud-init is still writing authorized_keys. Seconds to wait after the
# IP appears before handing the VM over.
#FIXTURE_SETTLE_SECONDS=90
